# Copy to .env and adjust. Never commit the real file.
#
# RPC endpoint for Monad testnet (chain id 10143).
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# The EventTickets contract the buyer pages use.
VITE_EVENT_ADDRESS=0x080266e2e193Afe65f72099E1cB804A4202D0fc8

# The EventTickets contract the scanner page uses. Optional: defaults to VITE_EVENT_ADDRESS.
# Check-in only works after the instance's eventStart, so this is usually a different
# deployment than the buyer pages.
VITE_SCANNER_EVENT_ADDRESS=0xB462AFdB02F46f011e9De4AcCBF117F30803b28b

# Privy App ID, for email login with an embedded wallet.
#
# Leave this empty to run with a browser wallet only: the app always offers an injected
# connector, and the Privy connector appears only when this value is present.
# The App ID is public (it ships in the client bundle). Never put the App Secret here.
VITE_PRIVY_APP_ID=
