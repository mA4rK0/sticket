# Copy to .env and fill in. Never commit the real file.
# All four are read by script/Deploy.s.sol.

# Official ticket price in wei (must be > 0). 0.01 MON:
TICKET_PRICE=10000000000000000

# Address that may check tickets in and withdraw proceeds:
ORGANIZER=0x0000000000000000000000000000000000000000

# Maximum number of tickets (must be > 0):
MAX_SUPPLY=500

# Unix timestamp of the event. Sales close and the door opens at this instant.
# Past   → check-in and withdraw work immediately (good for a live demo).
# Future → the "Sales closed" / "Event not started" reverts are demonstrable.
EVENT_START=1700000000

# Monad testnet RPC endpoint (chain id 10143):
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
